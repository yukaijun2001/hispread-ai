{
  "basis": "Static reading of all recovered frontend branches; runtime backend enforcement must separately verify permissions and tenant scope.",
  "apiPrefix": "/api",
  "pageResponseContract": {
    "items": [],
    "total": 0,
    "page": 1,
    "size": 10
  },
  "roleBranches": {
    "ADMIN": {
      "supplierId": null,
      "role": "ADMIN",
      "routes": [
        "workbench",
        "suppliers",
        "operator-kpi",
        "supplier-accounts",
        "projects",
        "quotes",
        "settlements",
        "resources",
        "resources-pending",
        "outbound-proxies",
        "resource-targets",
        "ccmax-resource-analysis",
        "reports",
        "notifications",
        "api-docs",
        "notice-admin",
        "users",
        "roles",
        "audits",
        "settings",
        "scheduled-tasks",
        "scheduled-task-runs",
        "payout-providers",
        "payout-recipients",
        "payout-calls"
      ],
      "notes": [
        "No supplier-only deliveries or supplier-agents routes. Platform resources equivalent is shown.",
        "settlements tabs daily,statements,inputs,payments,rates governed by permissions. No supplier departments tab.",
        "ccmax-resource-analysis requires report.read and resource.read plus no supplierId."
      ]
    },
    "SUPPLIER_AGENT": {
      "supplierId": "parent supplier ID",
      "role": "SUPPLIER_AGENT",
      "routes": [
        "workbench",
        "deliveries",
        "deliveries-pending",
        "outbound-proxies",
        "settlements?tab=daily"
      ],
      "conditionalRoutes": {
        "settlements?tab=departments": "teamAdminGroup.id exists",
        "supplier-agents": "teamAdminGroup.id exists"
      },
      "notes": [
        "api-docs explicitly hidden and route denied for member.",
        "settlement statements/payments/rates not in member tabs.",
        "quotes/reports require explicitly granted permissions; do not give by accident.",
        "all read/write resource operations scoped to owning member or authorized group.",
        "Local backend supplier-bills read gate explicitly allows member own/group-scoped daily bills, matching the recovered member tab availability even if settlement.read is absent."
      ]
    },
    "SUPPLIER": {
      "supplierId": "own supplier ID",
      "role": "SUPPLIER",
      "existingAudit": "14 supplier views"
    }
  },
  "endpoints": [
    {
      "route": "all",
      "module": "core/index.js",
      "method": "GET",
      "path": "/api/auth/me",
      "responseShape": "authenticated user object",
      "requiredFields": [
        "id",
        "username",
        "displayName",
        "role",
        "supplierId",
        "permissions",
        "mustChangePassword",
        "onboardingRequired",
        "teamAdminGroup"
      ],
      "when": "bootstrap",
      "notes": "ADMIN must have supplierId=null and role ADMIN; SUPPLIER_AGENT must retain parent supplierId. permissions is a string[]."
    },
    {
      "route": "workbench",
      "module": "system/workbench__Workbench.js",
      "method": "GET",
      "path": "/api/workbench",
      "responseShape": "object",
      "requiredFields": [
        "money",
        "todos",
        "announcement",
        "recent"
      ],
      "when": "initial",
      "notes": "money/todos/recent must be arrays even when empty; same supplier payload plus platform counters as available."
    },
    {
      "route": "workbench",
      "module": "system/workbench__Workbench.js",
      "method": "GET",
      "path": "/api/workbench/monitoring",
      "responseShape": "array",
      "requiredFields": [
        "category",
        "categoryName",
        "rpm",
        "tpm",
        "queriedAt"
      ],
      "when": "initial",
      "notes": ""
    },
    {
      "route": "workbench",
      "module": "system/workbench__Workbench.js",
      "method": "GET",
      "path": "/api/turnover",
      "responseShape": "object {items:[]}",
      "requiredFields": [
        "items"
      ],
      "when": "permission turnover.read",
      "notes": "Each item: businessDate,siteName,currency,amount,note."
    },
    {
      "route": "all",
      "module": "core/index.js",
      "method": "GET",
      "path": "/api/notifications/unread-count",
      "responseShape": "object {count:0}",
      "requiredFields": [
        "count"
      ],
      "when": "initial",
      "notes": ""
    },
    {
      "route": "all",
      "module": "core/index.js",
      "method": "GET",
      "path": "/api/notifications?unread=true&size=5",
      "responseShape": "page object {items:[],total:0,page:1,size:10}",
      "requiredFields": [
        "items"
      ],
      "when": "bell opened",
      "notes": ""
    },
    {
      "route": "suppliers",
      "module": "supplier/Suppliers.js",
      "method": "GET",
      "path": "/api/suppliers?search=&state=&owner=&page=1&size=10",
      "responseShape": "page object {items:[],total:0,page:1,size:10}",
      "requiredFields": [
        "items",
        "total",
        "page",
        "size"
      ],
      "when": "initial",
      "notes": "Supplier row: id,code,name,supplierType,country,contact,phone,email,cycle,state,enabled,version,ownerName."
    },
    {
      "route": "suppliers",
      "module": "supplier/Suppliers.js",
