      "responseShape": "page object {items:[],total:0,page:1,size:10}",
      "requiredFields": [
        "items",
        "total",
        "page",
        "size"
      ],
      "when": "report tab",
      "notes": "Each row includes ownerUserId,ownerName,currency, supplierCount and receivable/payable totals."
