      "path": "/api/suppliers/owner-candidates?includeHistory=true",
      "responseShape": "array",
      "requiredFields": [
        "id",
        "username",
        "displayName"
      ],
      "when": "initial",
      "notes": ""
    },
    {
      "route": "suppliers",
      "module": "supplier/Suppliers.js",
      "method": "GET",
      "path": "/api/suppliers/available-users",
      "responseShape": "array",
      "requiredFields": [
        "id",
        "username",
        "displayName"
      ],
      "when": "create supplier dialog",
      "notes": ""
    },
    {
      "route": "suppliers",
